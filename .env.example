# Server origin used for metadata and CSRF checks. Set verified HTTPS origin before launch.
SITE_URL=http://localhost:3000

# Fresh Supabase project. Never commit live values to .env.example or source files.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Generate a random 32+ byte value, e.g. with `openssl rand -hex 32`.
RATE_LIMIT_SECRET=
# Only set true behind a trusted reverse proxy that overwrites X-Real-IP.
RATE_LIMIT_TRUST_PROXY=false

# Test script only. Use an isolated non-production database.
# TEST_DATABASE_URL=
# ALLOW_REMOTE_TEST_DATABASE=yes
